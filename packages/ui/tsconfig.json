{
  "extends": "../../tooling/typescript/strict.json",
  "compilerOptions": {
    "rootDir": "src",
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "types": ["react"],
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
